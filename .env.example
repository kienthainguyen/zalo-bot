# File cấu hình trên VPS (/opt/zalo-bot/.env). KHÔNG gửi file này cho ai.
# install.sh tự điền PUBLIC_URL, các SECRET và VNC_URL. Anh chỉ cần điền 2 dòng có đánh dấu (*).

PORT=8787
PUBLIC_URL=https://bot.kienthainguyen.com
DATA_DIR=./data

# (*) Token bot lấy ở https://bot.zaloplatforms.com
ZALO_BOT_TOKEN=
ZALO_WEBHOOK_SECRET=
# Bot Zalo thứ 2 (vd bot báo cáo của app dựng video) cũng làm trợ lí y hệt. Điền token rồi restart, bot tự trỏ webhook.
# Nhắn "id" cho bot 2 rồi thêm id đó vào ALLOWED_ZALO_IDS. Tin báo cáo của app vẫn gửi bình thường.
ZALO_BOT2_TOKEN=
# (*) Zalo id được ra lệnh, cách nhau dấu phẩy. Nhắn "id" cho bot để biết id của mình.
ALLOWED_ZALO_IDS=

NOTIFY_SECRET=
# Trang noVNC để đăng nhập lại Chrome của VPS (bot gửi link này khi bị đăng xuất)
VNC_URL=

# Claude Code trên VPS (thường để mặc định)
# CLAUDE_BIN=claude
# AGENT_MODEL=
# AGENT_TIMEOUT_MIN=120

# Trợ lí 3 AI (Claude làm, GPT phản biện, Gemini trọng tài).
# Mặc định dùng GÓI ĐĂNG KÝ đã đăng nhập trên VPS (user zalobot): Claude Code (Claude Max), codex (ChatGPT Plus),
# gemini (Google AI Pro). Không cần khoá API. Chỉ điền khoá nếu muốn AI đó chạy bằng API thay vì gói.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Chọn model (để trống = mặc định của từng công cụ)
# CLAUDE_MODEL=
# OPENAI_MODEL=
# GEMINI_MODEL=
# Giờ gửi tự động (giờ Việt Nam)
# DAILY_BRIEF_HOUR=7
# WEEKLY_REPORT_HOUR=8
# MONTHLY_REPORT_HOUR=8
# Mấy phút kiểm tra video đang dựng 1 lần
# VIDEO_CHECK_MIN=10
